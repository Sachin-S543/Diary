{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDirs": ["./src", "../../packages/types/src"],
        "module": "commonjs",
        "target": "es2020",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "baseUrl": ".",
        "paths": {
            "@secret-capsule/types": ["../../packages/types/src/index.ts"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/**/__tests__/**",
        "src/**/*.test.ts",
        "dist/**",
        "node_modules"
    ]
}